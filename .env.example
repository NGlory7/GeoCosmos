GEMINI_API_KEY=
# gemini-2.5-flash yeni anahtarlara kapalı (404 "no longer available to new users").
# Lite: 180 yorum için hızlı (istek başına ~3 sn); gemini-3.5-flash daha yavaş "düşünen" model.
GEMINI_MODEL=gemini-3.5-flash-lite
EE_PROJECT=
# ESA CCI Permafrost GeoTIFF asset(ler)i, virgülle (K. Yarımküre, Antarktika). Boşsa ground_ice boş kalır.
EE_PERMAFROST_ASSETS=
# Virgülle ayrılmış liste; yayında frontend adresini ekleyin (sonda / olmadan da olur, temizlenir).
API_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
# Yayındaki API: grid.parquet repoda değilse indirileceği adres (ör. GitHub Releases). Yerelde boş.
GRID_URL=
